<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="start" android:enabled="true" android:icon="@drawable/ic_notification"
        android:shortcutShortLabel="@string/shortcut_start">
        <intent android:action="io.github.willzy12h.nocturne.COMMAND" android:targetPackage="io.github.willzy12h.nocturne"
            android:targetClass="io.github.willzy12h.nocturne.ui.ShortcutActivity">
            <extra android:name="command" android:value="START_NIGHT" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="turbo" android:enabled="true" android:icon="@drawable/ic_notification"
        android:shortcutShortLabel="@string/shortcut_turbo">
        <intent android:action="io.github.willzy12h.nocturne.COMMAND" android:targetPackage="io.github.willzy12h.nocturne"
            android:targetClass="io.github.willzy12h.nocturne.ui.ShortcutActivity">
            <extra android:name="command" android:value="TURBO" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="boost" android:enabled="true" android:icon="@drawable/ic_notification"
        android:shortcutShortLabel="@string/shortcut_boost">
        <intent android:action="io.github.willzy12h.nocturne.COMMAND" android:targetPackage="io.github.willzy12h.nocturne"
            android:targetClass="io.github.willzy12h.nocturne.ui.ShortcutActivity">
            <extra android:name="command" android:value="BOOST" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="off" android:enabled="true" android:icon="@drawable/ic_notification"
        android:shortcutShortLabel="@string/shortcut_off">
        <intent android:action="io.github.willzy12h.nocturne.COMMAND" android:targetPackage="io.github.willzy12h.nocturne"
            android:targetClass="io.github.willzy12h.nocturne.ui.ShortcutActivity">
            <extra android:name="command" android:value="OFF" />
        </intent>
    </shortcut>
</shortcuts>
