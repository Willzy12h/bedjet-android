<?xml version="1.0" encoding="utf-8"?>
<!-- A static picture of Controls for the widget picker: temperature, status and the default pills. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:background="@drawable/widget_preview_background" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_temperature_unknown_short" android:contentDescription="@string/widget_temperature_unknown"
        android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp">
        <TextView android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:text="@string/mode_turbo" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:text="@string/mode_heat" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:text="@string/feature_off" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
